{
    "name": "jk-tech-frontend",
    "version": "0.0.0",
    "scripts": {
      "ng": "ng",
      "start": "ng serve",
      "build": "ng build",
      "watch": "ng build --watch --configuration development",
      "test": "ng test",
      "updatePackage": "gulp --gulpfile buildScripts/npmBumpVersions.js --type $npm_config_type --env $npm_config_env",
      "deploy": "gulp --gulpfile buildScripts/s3-upload.js --env $npm_config_env",
      "aotfalsebuild": "ng build -$npm_config_env --aot=false",
      "build-deploy": "npm-run-all aotfalsebuild deploy"
    },
    "private": true,
    "dependencies": {
      "@angular/animations": "^17.0.0",
      "@angular/cdk": "^17.0.0",
      "@angular/common": "^17.0.0",
      "@angular/compiler": "^17.0.0",
      "@angular/core": "^17.0.0",
      "@angular/forms": "^17.0.0",
      "@angular/material": "^17.0.0",
      "@angular/platform-browser": "^17.0.0",
      "@angular/platform-browser-dynamic": "^17.0.0",
      "@angular/router": "^17.0.0",
      "rxjs": "~7.8.0",
      "tslib": "^2.3.0",
      "zone.js": "~0.14.2"
    },
    "devDependencies": {
      "@angular-devkit/build-angular": "^17.0.0",
      "@angular/cli": "^17.0.0",
      "@angular/compiler-cli": "^17.0.0",
      "@types/jasmine": "~5.1.0",
      "jasmine-core": "~5.1.0",
      "karma": "~6.4.0",
      "karma-chrome-launcher": "~3.2.0",
      "karma-coverage": "~2.2.0",
      "karma-jasmine": "~5.1.0",
      "karma-jasmine-html-reporter": "~2.1.0",
      "typescript": "~5.2.2"
    }
  } 